# Database
DATABASE_URL="file:./dev.db"

# OpenAI API Key (used via Vercel AI SDK / AI Gateway)
# When deployed on Vercel, you can also use BYOK through AI Gateway settings
OPENAI_API_KEY="sk-..."

# Pinterest Search Service URL (your existing Pinterest scraper endpoint)
# Expected: GET {PINTEREST_API_URL}/search?q={keywords}&limit={limit}
# Response: { results: [{ url, imageUrl, title, description }] }
PINTEREST_API_URL="http://localhost:3001"
